<Window x:Class="Weather.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Weather"
        mc:Ignorable="d"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Стиль для кнопок со скругленными углами -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стиль для текстового поля со скругленными углами -->
        <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="#BBDEFB"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Конкретные стили для кнопок -->
        <Style x:Key="SearchButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        
        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска города -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Иконка поиска -->
                <Border Grid.Column="0" 
                        Width="40" 
                        Height="40" 
                        Background="#1976D2" 
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">
                    <TextBlock Text="🔍" 
                               FontSize="18" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <TextBox Grid.Column="1" 
                         x:Name="CityTextBox" 
                         Height="40" 
                         Style="{StaticResource RoundedTextBoxStyle}"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2" 
                        x:Name="SearchButton"
                        Content="Найти" 
                        Click="SearchButton_Click"
                        Style="{StaticResource SearchButtonStyle}"
                        Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- Заголовок с датой -->
        <Border Grid.Row="1" Background="#E3F2FD" Padding="25,20" Margin="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Иконка локации -->
                <Border Grid.Column="0" 
                        Width="50" 
                        Height="50" 
                        Background="#2196F3" 
                        CornerRadius="10"
                        VerticalAlignment="Center">
                    <TextBlock Text="📍" 
                               FontSize="22" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="LocationText" 
                               Text="Пермь, Россия" 
                               FontSize="22" 
                               Foreground="#1976D2"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <!-- Иконка календаря -->
                        <Border Width="40" 
                                Height="38" 
                                Background="#2196F3" 
                                CornerRadius="8,0,0,8"
                                VerticalAlignment="Center">
                            <TextBlock Text="📅" 
                                       FontSize="18" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>

                        <ComboBox SelectionChanged="SelectDay" 
                                  Name="Days" 
                                  Width="180" 
                                  Height="38" 
                                  Background="White"
                                  Foreground="#333333"
                                  BorderThickness="1"
                                  BorderBrush="#90CAF9"
                                  VerticalAlignment="Center"
                                  FontSize="14"
                                  Padding="10,0"
                                  Margin="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Padding="5"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Content="🔄 Обновить" 
                                Click="UpdateWeather" 
                                Style="{StaticResource UpdateButtonStyle}"
                                Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Заголовки таблицы -->
        <Border Grid.Row="2" Background="#F5F9FF" Padding="15,12">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.15*"/>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.25*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🕐" 
                               FontSize="14" 
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Время" 
                               Foreground="#1976D2" 
                               FontSize="12" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🌡️" 
                               FontSize="14" 
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Температура" 
                               Foreground="#1976D2" 
                               FontSize="12" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📊" 
                               FontSize="14" 
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Давление" 
                               Foreground="#1976D2" 
                               FontSize="12" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="💧" 
                               FontSize="14" 
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Влажность" 
                               Foreground="#1976D2" 
                               FontSize="12" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область с прогнозом -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Background="White">
            <StackPanel Name="parent" Margin="10"/>
        </ScrollViewer>
    </Grid>
</Window>