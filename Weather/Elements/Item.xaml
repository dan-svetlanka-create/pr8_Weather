<UserControl x:Class="Weather.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
            
             d:DesignHeight="80" d:DesignWidth="800">

    <Border Background="White" 
            CornerRadius="8" 
            Padding="10" 
            Margin="10,5"
            BorderBrush="#E3F2FD" 
            BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.15*"/>
                <ColumnDefinition Width="0.35*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.2*"/>
                <ColumnDefinition Width="0.1*"/>
                <!-- Добавил колонку для иконки -->
            </Grid.ColumnDefinitions>

            <!-- Время -->
            <StackPanel Grid.Column="0" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <TextBlock Text="🕐" 
                           FontSize="16" 
                           HorizontalAlignment="Center"/>
                <Label x:Name="lHour" 
                       Foreground="#333333" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Padding="0" 
                       Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Температура -->
            <StackPanel Grid.Column="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <TextBlock Text="🌡️" 
                               FontSize="20" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <Label x:Name="lTemp" 
                           Foreground="#333333" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Padding="0"/>
                </StackPanel>
                <Label x:Name="lCondition" 
                       Foreground="#666666" 
                       FontSize="12" 
                       HorizontalAlignment="Center"
                       Padding="0" 
                       Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Давление -->
            <StackPanel Grid.Column="2" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <TextBlock Text="📊" 
                               FontSize="20" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <Label x:Name="lPressure" 
                           Foreground="#333333" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Padding="0"/>
                </StackPanel>
                <TextBlock Text="мм рт.ст." 
                           Foreground="#666666" 
                           FontSize="12" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Влажность -->
            <StackPanel Grid.Column="3" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center">
                    <TextBlock Text="💧" 
                               FontSize="20" 
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <Label x:Name="lHumidity" 
                           Foreground="#333333" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Padding="0"/>
                </StackPanel>
                <TextBlock Text="%" 
                           Foreground="#666666" 
                           FontSize="12" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Иконка погоды (дополнительно) -->
            <StackPanel Grid.Column="4" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <TextBlock x:Name="lWeatherIcon"
                           FontSize="24"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="погода"
                           Foreground="#666666" 
                           FontSize="10"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>